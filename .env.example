# Supabase Database & Auth (PostgreSQL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# WhatsApp Business / Helpline
NEXT_PUBLIC_WHATSAPP_NUMBER=966500000000

# Meta AI Social Poster & Inbox Qualification Agent
META_PAGE_ACCESS_TOKEN=EAAB...
META_PAGE_ID=100000000000000
META_VERIFY_TOKEN=probashi_meta_verify_secret_token
